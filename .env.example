# NeuroPlay — ambiente local ou produção
# Copie para .env e substitua todos os valores de exemplo.
# Nunca faça commit de .env nem reutilize secrets entre ambientes.

APP_ENV=development
FLASK_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters

POSTGRES_USER=neuroplay
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=neuroplay
DATABASE_URL=postgresql://neuroplay:replace-with-a-local-password@db:5432/neuroplay

REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_API_URL=http://localhost:5000
CONSENT_VERSION=2026-01
JWT_ACCESS_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Perfil administrativo opcional; não exponha PgAdmin em produção.
PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=replace-with-an-admin-password

# Produção: configure estes valores no secret manager do provedor.
# APP_ENV=production
# SECRET_KEY=<secret-randomico-com-32-ou-mais-caracteres>
# DATABASE_URL=<url-postgresql-gerenciada-com-tls>
# REDIS_URL=<url-redis-gerenciada-com-tls>
# CORS_ORIGINS=https://dev-hp.github.io
# FRONTEND_API_URL=https://seu-backend.example.com
